{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "context": "."
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "healthcheckInterval": 10,
    "healthcheckRetries": 5
  },
  "variables": {
    "RAILWAY_DOCKERFILE_PATH": "backend/Dockerfile",
    "NODE_ENV": "production"
  }
}